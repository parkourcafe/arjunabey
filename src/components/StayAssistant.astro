---
/**
 * Instant, deterministic stay assistant.
 *
 * It answers only from verified site facts and routes guests into the pricing
 * planner or the verified self-serve Airbnb checkout. No model/API is used,
 * so replies remain fast, private and available on every page.
 */
import { whatsappLink } from "../lib/whatsapp";

const waHref = whatsappLink();
---

<div
  class="fixed bottom-20 right-4 z-40 flex flex-col items-end md:bottom-6 md:right-6"
  data-stay-assistant
>
  <section
    class="absolute bottom-16 right-0 hidden max-h-[min(680px,calc(100dvh-7rem))] w-[calc(100vw-2rem)] max-w-[390px] flex-col overflow-hidden border border-hairline bg-paper shadow-[0_18px_60px_rgba(28,26,23,0.22)]"
    data-assistant-panel
    role="dialog"
    aria-modal="false"
    aria-label="Anjuna Bay instant stay assistant"
  >
    <header
      class="flex items-center justify-between border-b border-hairline bg-sand px-5 py-4"
    >
      <div>
        <p class="font-serif text-lg text-ink">Anjuna stay assistant</p>
        <p class="mt-0.5 flex items-center gap-1.5 text-xs text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ocean" aria-hidden="true"
          ></span>
          Instant answers
        </p>
      </div>
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center text-ink"
        data-assistant-close
        aria-label="Close stay assistant"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </header>

    <div
      class="min-h-0 flex-1 space-y-3 overflow-y-auto px-5 py-5"
      data-assistant-log
      role="log"
      aria-live="polite"
      aria-relevant="additions"
    >
      <div
        class="max-w-[88%] bg-sand px-4 py-3 text-sm leading-relaxed text-ink"
      >
        Hi — I can help you choose a villa, explain rates and take you straight
        to live availability.
      </div>
    </div>

    {
      waHref && (
        <p class="border-t border-hairline px-5 py-3 text-xs leading-relaxed text-muted">
          Need a person?{" "}
          <a
            class="text-ocean underline underline-offset-4"
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open WhatsApp
          </a>
          .
        </p>
      )
    }

    <div class="border-t border-hairline px-5 py-3">
      <p class="mb-2 text-[11px] uppercase tracking-[0.12em] text-muted">
        Quick answers
      </p>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class="border border-hairline px-3 py-2 text-xs text-ocean"
          data-assistant-topic="book"
        >
          Book now
        </button>
        <button
          type="button"
          class="border border-hairline px-3 py-2 text-xs text-ocean"
          data-assistant-topic="price"
        >
          Prices
        </button>
        <button
          type="button"
          class="border border-hairline px-3 py-2 text-xs text-ocean"
          data-assistant-topic="villa"
        >
          Choose a villa
        </button>
        <button
          type="button"
          class="border border-hairline px-3 py-2 text-xs text-ocean"
          data-assistant-topic="beach"
        >
          Beach
        </button>
        <button
          type="button"
          class="border border-hairline px-3 py-2 text-xs text-ocean"
          data-assistant-topic="construction"
        >
          Construction
        </button>
      </div>
    </div>

    <form
      class="flex gap-2 border-t border-hairline bg-paper p-3"
      data-assistant-form
    >
      <label class="sr-only" for="anjuna-assistant-question"
        >Ask a question</label
      >
      <input
        id="anjuna-assistant-question"
        name="question"
        type="text"
        autocomplete="off"
        placeholder="Ask about your stay…"
        class="min-w-0 flex-1 border border-hairline bg-sand px-3 py-3 text-sm text-ink placeholder:text-muted focus:border-ocean focus:outline-none"
        data-assistant-input
      />
      <button
        type="submit"
        class="flex h-11 w-11 shrink-0 items-center justify-center bg-ocean text-paper"
        aria-label="Send question"
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M4 12h14M13 6l6 6-6 6"></path>
        </svg>
      </button>
    </form>
  </section>

  <button
    type="button"
    class="flex items-center gap-2 bg-ocean px-3 py-3 text-left text-paper shadow-[0_8px_30px_rgba(28,26,23,0.2)] transition-colors duration-400 hover:bg-ocean-dark sm:gap-3 sm:px-4"
    data-assistant-open
    aria-expanded="false"
    aria-label="Ask Anjuna — instant stay answers"
  >
    <span
      class="flex h-9 w-9 items-center justify-center rounded-full border border-paper/35"
      aria-hidden="true"
    >
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M5 17.5 3.5 21l4-1.5A9 9 0 1 0 5 17.5Z"></path>
        <path d="M8 12h.01M12 12h.01M16 12h.01"></path>
      </svg>
    </span>
    <span class="text-sm font-medium sm:hidden">Ask</span>
    <span class="hidden sm:block">
      <span class="block text-sm font-medium">Ask Anjuna</span>
      <span class="block text-[11px] text-paper/75">Instant stay answers</span>
    </span>
  </button>
</div>

<script>
  type AssistantAnswer = { text: string; href?: string; label?: string };

  const answers: Record<string, AssistantAnswer> = {
    book: {
      text: "Choose a villa and your dates to see the Anjuna Bay estimate. The next button opens that villa’s verified Airbnb listing with live availability, fees, cancellation terms and secure checkout — no need to wait for a reply.",
      href: "/book",
      label: "Plan and book your stay",
    },
    price: {
      text: "Rates change by season, weekday and stay length. The calculator covers 1 August 2026 to 31 January 2027 and applies the published length-of-stay saving automatically.",
      href: "/book",
      label: "Calculate your dates",
    },
    villa: {
      text: "Choose by group size: 1-bedroom villas sleep up to 2, 2-bedroom villas up to 4, and 3-bedroom villas up to 6. Every published villa has a private pool, kitchen, air conditioning, wifi and daily housekeeping.",
      href: "/villas",
      label: "Compare all villas",
    },
    beach: {
      text: "Anjuna Bay is by Thomas Beach in Pecatu, Uluwatu. Each villa page shows its currently published walk time so you can compare before booking.",
      href: "/the-place",
      label: "Explore the location",
    },
    construction: {
      text: "Parts of the estate are still being built, typically 8am–5pm, and nearby Uluwatu nightlife may sometimes be audible. Every villa page carries the disclosure before booking.",
      href: "/villas",
      label: "View villa details",
    },
    transfer: {
      text: "Airport transfer can be arranged on request. The current price is confirmed before you add it to the stay.",
    },
    cancellation: {
      text: "Cancellation terms are shown by Airbnb for the live listing before payment. For a future direct Guesty booking, the final rate and cancellation terms will be shown before you commit.",
    },
    payment: {
      text: "The current self-serve route uses Airbnb’s secure checkout. The Anjuna calculator itself never takes payment or claims a villa is available.",
    },
    housekeeping: {
      text: "Daily housekeeping is included in every currently published villa.",
    },
    photos: {
      text: "Tap any photo on a villa page to open it full screen. Swipe on mobile or use the arrow keys on desktop.",
      href: "/villas",
      label: "Open the villa collection",
    },
  };

  function resolveAnswer(question: string): AssistantAnswer {
    const value = question.toLowerCase();
    if (/(book|reserve|available|availability|заброн|брон)/.test(value))
      return answers.book;
    if (/(price|rate|cost|discount|цена|стоим|скид)/.test(value))
      return answers.price;
    if (/(villa|bedroom|guest|sleep|вилл|спаль|гост)/.test(value))
      return answers.villa;
    if (/(beach|location|walk|thomas|пляж|локац)/.test(value))
      return answers.beach;
    if (/(construction|noise|quiet|music|строй|шум|тиш)/.test(value))
      return answers.construction;
    if (/(airport|transfer|pickup|аэроп|трансфер)/.test(value))
      return answers.transfer;
    if (/(cancel|refund|отмен|возврат)/.test(value))
      return answers.cancellation;
    if (/(pay|payment|card|оплат|карт)/.test(value)) return answers.payment;
    if (/(housekeep|clean|уборк)/.test(value)) return answers.housekeeping;
    if (/(photo|gallery|image|фото|галере)/.test(value)) return answers.photos;
    return {
      text: "I do not want to guess. I can answer instantly about villas, prices, booking, beach access, construction, transfers, cancellation, payment, housekeeping or photos.",
    };
  }

  document
    .querySelectorAll<HTMLElement>("[data-stay-assistant]")
    .forEach((assistant) => {
      const panel = assistant.querySelector<HTMLElement>(
        "[data-assistant-panel]",
      );
      const openButton = assistant.querySelector<HTMLButtonElement>(
        "[data-assistant-open]",
      );
      const closeButton = assistant.querySelector<HTMLButtonElement>(
        "[data-assistant-close]",
      );
      const form = assistant.querySelector<HTMLFormElement>(
        "[data-assistant-form]",
      );
      const input = assistant.querySelector<HTMLInputElement>(
        "[data-assistant-input]",
      );
      const log = assistant.querySelector<HTMLElement>("[data-assistant-log]");

      function open() {
        panel?.classList.remove("hidden");
        panel?.classList.add("flex");
        openButton?.setAttribute("aria-expanded", "true");
        input?.focus();
      }

      function close() {
        panel?.classList.add("hidden");
        panel?.classList.remove("flex");
        openButton?.setAttribute("aria-expanded", "false");
        openButton?.focus();
      }

      function addMessage(
        text: string,
        sender: "guest" | "assistant",
        action?: AssistantAnswer,
      ) {
        if (!log) return;
        const bubble = document.createElement("div");
        bubble.className =
          sender === "guest"
            ? "ml-auto max-w-[88%] bg-ocean px-4 py-3 text-sm leading-relaxed text-paper"
            : "max-w-[88%] bg-sand px-4 py-3 text-sm leading-relaxed text-ink";
        const copy = document.createElement("p");
        copy.textContent = text;
        bubble.append(copy);
        if (sender === "assistant" && action?.href && action.label) {
          const link = document.createElement("a");
          link.href = action.href;
          link.textContent = action.label;
          link.className =
            "mt-3 inline-block font-medium text-ocean underline underline-offset-4";
          bubble.append(link);
        }
        log.append(bubble);
        log.scrollTop = log.scrollHeight;
      }

      function answer(topicOrQuestion: string, showGuestMessage = true) {
        const answer =
          answers[topicOrQuestion] ?? resolveAnswer(topicOrQuestion);
        if (showGuestMessage) addMessage(topicOrQuestion, "guest");
        window.setTimeout(
          () => addMessage(answer.text, "assistant", answer),
          120,
        );
      }

      openButton?.addEventListener("click", () => {
        if (panel?.classList.contains("hidden")) open();
        else close();
      });
      closeButton?.addEventListener("click", close);
      assistant
        .querySelectorAll<HTMLButtonElement>("[data-assistant-topic]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const topic = button.dataset.assistantTopic ?? "";
            addMessage(button.textContent?.trim() ?? topic, "guest");
            answer(topic, false);
          });
        });
      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        const question = input?.value.trim() ?? "";
        if (!question) return;
        answer(question);
        if (input) input.value = "";
      });
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          panel &&
          !panel.classList.contains("hidden")
        )
          close();
      });
    });
</script>
