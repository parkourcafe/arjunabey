---
/**
 * CookieConsent — the hard analytics gate (CLAUDE.md, docs/BUILD.md §9).
 *
 * RULE: zero non-essential tags fire before explicit consent. This component
 * is the ONLY place GA4/Meta Pixel script tags are ever injected into the
 * DOM — they do not exist in any page's static HTML. On load it checks
 * localStorage for a prior choice; with none, it shows the banner and waits.
 * Tags are added as `type="text/partytown"` so @astrojs/partytown moves them
 * off the main thread once they do load (perf budget, docs/BUILD.md §9).
 *
 * A "Cookie preferences" link (Footer.astro) calls `window.__anjunaOpenConsent()`
 * to reopen this banner and change the choice later.
 */
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID;
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-hairline bg-paper/98 px-5 py-3.5 shadow-[0_-4px_20px_rgba(28,26,23,0.08)] backdrop-blur md:px-16 md:py-4"
  role="dialog"
  aria-label="Cookie preferences"
  aria-live="polite"
>
  <div class="container-content flex flex-row items-center justify-between gap-4 !px-0">
    <p class="max-w-prose text-xs leading-snug text-muted md:text-sm">
      A few cookies help us understand how the site is used. Nothing loads until you say yes —
      <a href="/privacy" class="underline">Privacy Notice</a>.
    </p>
    <!-- Decline and Accept carry equal visual weight. A bright Accept beside a
         greyed-out Decline is a dark pattern: it reads as cheap next to an
         owner who is judging the brand, and in several jurisdictions it does
         not constitute valid consent at all (ТЗ §7). -->
    <div class="flex shrink-0 items-center gap-2.5">
      <button
        type="button"
        id="cookie-decline"
        class="border border-ocean px-5 py-2 text-xs font-medium tracking-wide text-ocean transition-colors duration-400 ease-elegant hover:bg-ocean/10 md:px-6 md:py-2.5 md:text-sm"
      >
        Decline
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="border border-ocean bg-ocean px-5 py-2 text-xs font-medium tracking-wide text-paper transition-colors duration-400 ease-elegant hover:bg-ocean-dark md:px-6 md:py-2.5 md:text-sm"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ GA4_ID, META_PIXEL_ID }}>
  const STORAGE_KEY = 'anjuna-consent';
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');

  function injectAnalyticsTags() {
    // Loaded as text/partytown so @astrojs/partytown proxies execution off
    // the main thread. Silently no-ops if an ID isn't configured yet
    // (fresh checkout / local dev) rather than injecting a broken src.
    if (GA4_ID) {
      const gtagSrc = document.createElement('script');
      gtagSrc.type = 'text/partytown';
      gtagSrc.src = `https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`;
      document.head.appendChild(gtagSrc);

      const gtagInit = document.createElement('script');
      gtagInit.type = 'text/partytown';
      gtagInit.textContent = `
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${GA4_ID}');
      `;
      document.head.appendChild(gtagInit);
    }

    if (META_PIXEL_ID) {
      const pixel = document.createElement('script');
      pixel.type = 'text/partytown';
      pixel.textContent = `
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '${META_PIXEL_ID}');
        fbq('track', 'PageView');
      `;
      document.head.appendChild(pixel);
    }

    // Flushes any events queued by src/lib/analytics.ts before consent.
    window.dispatchEvent(new CustomEvent('anjuna:consent-granted'));
  }

  // The banner is fixed to the bottom, so on a phone it sat directly over the
  // hero's Reserve and Explore buttons — unclickable on every first visit,
  // which is the only visit that matters in a demo. Reserve the space it
  // occupies while it is up, and give it back when it goes.
  function reserveSpace() {
    if (!banner) return;
    const height = banner.offsetHeight + 'px';
    // Body padding handles ordinary page flow. The hero is sized in svh, so
    // padding below it moves nothing — it reads the variable instead and
    // lifts its own buttons clear while the banner is up.
    document.body.style.paddingBottom = height;
    document.documentElement.style.setProperty('--consent-height', height);
    liftFloatingControls();
  }

  function hideBanner() {
    banner?.classList.add('hidden');
    document.body.style.paddingBottom = '';
    document.documentElement.style.setProperty('--consent-height', '0px');
  }

  function showBanner() {
    banner?.classList.remove('hidden');
    reserveSpace();
    window.addEventListener('resize', reserveSpace, { passive: true });
  }

  // The WhatsApp bubble and the assistant sit bottom-right; without this the
  // banner lands on top of them (ТЗ §7).
  function liftFloatingControls() {
    document.querySelectorAll('[data-floating-action]').forEach((el) => {
      el.style.marginBottom = 'var(--consent-height, 0px)';
    });
  }

  function applyStoredChoice() {
    const choice = localStorage.getItem(STORAGE_KEY);
    if (choice === 'granted') {
      injectAnalyticsTags();
      hideBanner();
    } else if (choice === 'denied') {
      hideBanner();
    } else {
      showBanner();
    }
  }

  function recordChoice(choice) {
    localStorage.setItem(STORAGE_KEY, choice);
    if (choice === 'granted') injectAnalyticsTags();
    hideBanner();
    // The consent rate decides how much of the rest of the analytics is even
    // representative, so it is measured itself (ТЗ §21).
    window.dispatchEvent(
      new CustomEvent('anjuna:track', { detail: { event: 'cookie_consent_set', choice } }),
    );
  }

  acceptBtn?.addEventListener('click', () => recordChoice('granted'));
  declineBtn?.addEventListener('click', () => recordChoice('denied'));

  // Escape is handled on the document, not the banner. The banner deliberately
  // does not steal focus when it appears — snatching it away from the hero on
  // first load is worse than the problem it solves — so a listener bound to the
  // banner would only ever fire once the guest had already tabbed into it.
  //
  // Escape declines rather than merely dismissing: leaving with no choice
  // recorded means the banner returns on the next page, and an unanswered
  // banner must never be treated as agreement.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (banner?.classList.contains('hidden')) return;
    recordChoice('denied');
  });

  // Tab cycles within the banner once focus is actually inside it.
  banner?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = banner.querySelectorAll('button, a[href]');
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Exposed for Footer.astro's "Cookie preferences" link.
  window.__anjunaOpenConsent = () => {
    showBanner();
    declineBtn?.focus();
  };

  applyStoredChoice();
</script>
