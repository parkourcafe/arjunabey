---
/**
 * Footer — the header's counterpart: same sand surface, same centred wordmark
 * in letter-spaced caps, same single row of sections. Compact by design.
 *
 * An earlier version indexed all twenty-three villas by bedroom count, which
 * alone ran to roughly a screen of names and left the footer sprawling. That
 * index is what /villas is for; the footer's job is to close the page, carry
 * the essentials (reach us, subscribe, policies) and send the reader back up.
 *
 * Guest social only — never @anjunabay, that account sells real estate
 * (CLAUDE.md rule 5).
 */
import { whatsappLink } from '../lib/whatsapp';

const year = new Date().getUTCFullYear();

const SECTIONS = [
  { label: 'Villas', href: '/villas' },
  { label: 'Experiences', href: '/experiences' },
  { label: 'The Place', href: '/the-place' },
  { label: 'Offers', href: '/offers' },
  { label: 'Journal', href: '/journal' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const POLICIES = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Accessibility', href: '/accessibility' },
];

// TODO(contact): confirm the public reservations address before launch — the
// phone number is deliberately absent rather than invented (CLAUDE.md rule 6).
const RESERVATIONS_EMAIL = 'stay@anjunabay.com';

// null when no number is configured yet; the enquiry form is the fallback so
// the row never renders a dead link.
const whatsapp = whatsappLink();
---

<footer class="border-t border-hairline bg-sand">
  <div class="container-content">
    <!-- Wordmark + sections: the header, mirrored -->
    <div class="flex flex-col items-center gap-5 pb-7 pt-12 text-center md:pt-14">
      <a
        href="/"
        class="font-serif text-lg font-light uppercase tracking-[0.22em] text-ink no-underline md:text-xl"
      >
        Anjuna&nbsp;Bay
      </a>

      <nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2.5">
        {
          SECTIONS.map((item) => (
            <a href={item.href} class="footer-link text-eyebrow uppercase">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Reach us / subscribe -->
    <div
      class="flex flex-col items-center gap-8 border-t border-hairline py-8 text-center md:flex-row md:items-start md:justify-between md:gap-12 md:text-left"
    >
      <div class="text-sm leading-relaxed text-muted">
        <p class="text-ink">Thomas Beach, Uluwatu, Pecatu · Bali, Indonesia</p>
        <p class="mt-1.5">
          {
            whatsapp ? (
              <a href={whatsapp} class="footer-link" target="_blank" rel="noopener noreferrer">
                WhatsApp
              </a>
            ) : (
              <a href="/contact" class="footer-link">
                Enquire
              </a>
            )
          }
          <span class="px-2 text-muted/50">·</span>
          <a href={`mailto:${RESERVATIONS_EMAIL}`} class="footer-link">{RESERVATIONS_EMAIL}</a>
          <span class="px-2 text-muted/50">·</span>
          <a href="/book" class="footer-link">Plan your stay</a>
        </p>
      </div>

      <form class="w-full max-w-sm" data-newsletter-form>
        <label for="footer-email" class="block text-sm text-muted">
          Occasional notes from the estate — no spam.
        </label>
        <div class="mt-3 flex items-center gap-3 border-b border-ink/25 focus-within:border-ocean">
          <input
            type="email"
            id="footer-email"
            name="email"
            required
            placeholder="Email address"
            class="w-full bg-transparent pb-2 text-sm text-ink placeholder:text-muted/70 focus:outline-none"
          />
          <button
            type="submit"
            class="shrink-0 pb-2 text-eyebrow uppercase text-ink transition-colors duration-400 ease-elegant hover:text-ocean"
          >
            Sign up
          </button>
        </div>
        <p class="mt-2 text-xs text-muted" data-newsletter-status role="status"></p>
      </form>
    </div>
  </div>

  <!-- Legal -->
  <div class="border-t border-hairline">
    <div
      class="container-content flex flex-col items-center gap-3 py-5 text-xs text-muted md:flex-row md:justify-between"
    >
      <p class="order-2 md:order-1">&copy; {year} Anjuna Bay. Independent villa operation.</p>
      <ul class="order-1 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 md:order-2">
        {
          POLICIES.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <button type="button" class="footer-link" data-open-consent>Cookies</button>
        </li>
        {/* Guest brand handles only — never @anjunabay (real estate). TODO: confirm handles. */}
        <li>
          <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer" class="footer-link">
            Instagram
          </a>
        </li>
        <li>
          <a href="/contact?type=investment" class="footer-link">Property enquiries</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Quiet links: ink until hover, underline arrives on hover rather than
     sitting there permanently, which keeps the footer calm. */
  .footer-link {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--duration-fade) var(--ease-elegant);
  }
  .footer-link:hover {
    color: var(--color-ocean);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<script>
  const form = document.querySelector('[data-newsletter-form]');
  const status = document.querySelector('[data-newsletter-status]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // TODO(newsletter-provider): wire to the chosen double-opt-in provider
    // (docs/BUILD.md §14 open dependencies). Placeholder acknowledgement only.
    if (status) status.textContent = 'Thanks — check your inbox to confirm.';
    (form as HTMLFormElement).reset();
  });

  document.querySelector('[data-open-consent]')?.addEventListener('click', () => {
    window.__anjunaOpenConsent?.();
  });
</script>
