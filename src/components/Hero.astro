---
/**
 * Hero — full-bleed image/video opener. Aman New York reference: video-first
 * hero, dark gradient scrim for legibility, one serif headline, minimal
 * overlay text, a calm CTA pair. Video is muted/playsinline/poster and
 * pauses under prefers-reduced-motion (docs/BUILD.md §7).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  image: ImageMetadata;
  imageAlt: string;
  /** Public path to an mp4/webm loop (e.g. /video/hero.mp4). The image stays as poster + reduced-motion fallback. */
  video?: string;
  /** Show the sound control. The file must carry an audio track: it autoplays
   *  muted (every browser requires that) and the control simply unmutes it.
   *  An earlier version swapped in a second, audio-bearing file on click and
   *  called play() before it had loaded, which left the hero paused at zero —
   *  one file, one muted flag, nothing to sequence. */
  hasSound?: boolean;
  eyebrow?: string;
  headline: string;
  subhead?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  height?: 'full' | 'tall';
}

const {
  image,
  imageAlt,
  video,
  hasSound = false,
  eyebrow,
  headline,
  subhead,
  primaryCta,
  secondaryCta,
  height = 'full',
} = Astro.props;
---

<section
  class:list={[
    'relative flex items-end overflow-hidden bg-ink',
    // Full-viewport: the film is the first thing a visitor meets and scale is
    // most of what makes it land. 100svh rather than 100vh so mobile browser
    // chrome does not push the composition off-screen.
    height === 'full' ? 'h-[100svh] min-h-[600px]' : 'h-[78vh] min-h-[460px]',
  ]}
>
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  {
    video && (
      <video
        class="hero-video hero-slow-zoom absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 motion-reduce:hidden"
        muted
        loop
        playsinline
        autoplay
        preload="metadata"
        poster={image.src}
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={video} type="video/mp4" />
      </video>
    )
  }
  <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/15 to-transparent" aria-hidden="true"></div>

  {
    video && hasSound && (
      <button
        type="button"
        class="absolute bottom-6 right-6 z-20 hidden h-11 w-11 items-center justify-center rounded-full border border-paper/50 text-paper transition-colors duration-400 ease-elegant hover:bg-paper/10 md:flex"
        data-sound-toggle
        aria-pressed="false"
        aria-label="Play with sound"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" data-icon-muted>
          <path d="M11 5 6 9H3v6h3l5 4V5Z" />
          <path d="m17 9 4 6M21 9l-4 6" />
        </svg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" class="hidden" data-icon-sound>
          <path d="M11 5 6 9H3v6h3l5 4V5Z" />
          <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
        </svg>
      </button>
    )
  }

  <div class="container-content relative z-10 pb-16 pt-32 text-paper md:pb-24">
    {eyebrow && <p class="eyebrow mb-4 text-paper/80">{eyebrow}</p>}
    <h1 class="max-w-4xl text-display font-serif font-light text-paper">{headline}</h1>
    {subhead && <p class="mt-5 max-w-xl font-serif text-lg italic text-paper/90 md:text-xl">{subhead}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-wrap gap-4">
          {primaryCta && (
            <a href={primaryCta.href} class="btn-primary" data-track="start_booking">
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-ghost-on-dark">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Barely-perceptible slow push-in on the video loop — the global
     prefers-reduced-motion rule zeroes animation durations, so this
     never plays for users who opt out of motion. */
  .hero-slow-zoom {
    animation: hero-zoom 28s linear infinite alternate;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }
</style>

<script>
  // Hero video: honour prefers-reduced-motion (pause + stay on poster image),
  // otherwise fade the loop in once it is actually playing.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLVideoElement>('.hero-video').forEach((video) => {
    if (reduceMotion.matches) {
      video.removeAttribute('autoplay');
      video.pause();
      return;
    }
    const reveal = () => video.classList.remove('opacity-0');
    if (!video.paused && video.readyState >= 2) reveal();
    else video.addEventListener('playing', reveal, { once: true });
    video.play().catch(() => {
      /* autoplay blocked — poster image remains */
    });
  });

  // Sound toggle. The film already carries its audio and is autoplaying muted,
  // so this only flips the flag — no source swap, nothing to reload or seek.
  const toggle = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
  if (toggle && heroVideo && !reduceMotion.matches) {
    toggle.addEventListener('click', () => {
      const turningOn = toggle.getAttribute('aria-pressed') !== 'true';

      heroVideo.muted = !turningOn;
      if (heroVideo.paused) heroVideo.play().catch(() => {});

      toggle.setAttribute('aria-pressed', String(turningOn));
      toggle.setAttribute('aria-label', turningOn ? 'Mute' : 'Play with sound');
      toggle.querySelector('[data-icon-muted]')?.classList.toggle('hidden', turningOn);
      toggle.querySelector('[data-icon-sound]')?.classList.toggle('hidden', !turningOn);
    });
  }
</script>
