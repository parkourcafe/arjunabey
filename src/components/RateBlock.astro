---
/**
 * RateBlock — evidence-based OTA guide and live booking hand-off.
 *
 * Category ranges are observations from supplied public OTA calendars. This
 * component never manufactures a stay total or claims live availability.
 */
import { bookingLink, hasGuestyBooking } from "../lib/guesty";
import { whatsappLink, whatsappNumber } from "../lib/whatsapp";
import {
  PRICING_CHECKOUT_MAX,
  PRICING_LAST_NIGHT,
  PRICING_START,
  formatIdr,
  observedRateGuide,
  type SupportedBedrooms,
} from "../lib/pricing";
import WhatsAppButton from "./WhatsAppButton.astro";

export interface Props {
  landmarkName: string;
  bedrooms: SupportedBedrooms;
  maximumGuests: number;
  pricingAdjustmentPercent?: number;
  guestyUnitId: string | null;
  airbnbUrl: string | null;
  ratePublic: number | null;
  freeCancelRate: number | null;
  currency: string;
  includes: string[];
  offPlan?: boolean;
}

const {
  landmarkName,
  bedrooms,
  maximumGuests,
  guestyUnitId,
  airbnbUrl,
  includes,
  offPlan = false,
} = Astro.props;

const guide = observedRateGuide(bedrooms);
const guestyHref = bookingLink(guestyUnitId);
const showGuestyCta = hasGuestyBooking(guestyUnitId) && guestyHref;
const bookingProvider = showGuestyCta
  ? "guesty"
  : airbnbUrl
    ? "airbnb"
    : "whatsapp";
const waNumber = whatsappNumber();
const genericWaHref = whatsappLink({ villa: landmarkName });
---

{
  offPlan ? (
    <div class="border border-hairline bg-paper p-6 md:p-8" id="rate">
      <p class="eyebrow mb-5 text-clay">Coming soon</p>
      <p class="font-serif text-2xl text-ink">Not yet available to book.</p>
      <p class="mt-4 text-sm leading-relaxed text-muted">
        We'll open {landmarkName} for reservations once its availability is confirmed.
      </p>
      <div class="mt-6">
        <WhatsAppButton
          villa={landmarkName}
          variant="button"
          class="w-full"
          label="Register interest"
        />
      </div>
    </div>
  ) : (
    <section
      class="border border-hairline bg-paper p-6 md:p-8"
      id="rate"
      data-rate-handoff
      data-villa={landmarkName}
      data-airbnb-url={airbnbUrl ?? ""}
      data-booking-provider={bookingProvider}
      data-whatsapp-number={waNumber ?? ""}
    >
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
        <div>
          <p class="eyebrow">Observed OTA rate guide</p>
          <h2 class="mt-2 font-serif text-2xl text-ink">
            Check live price and availability
          </h2>
        </div>
        <p class="shrink-0 text-left text-sm text-muted sm:text-right">
          Observed from
          <span class="block font-serif text-2xl text-ink">
            {formatIdr(guide.minimum)}
          </span>
          per night
        </p>
      </div>

      <div class="mt-6 border-l-2 border-clay pl-4">
        <p class="text-sm leading-relaxed text-ink">
          Public OTA calendars observed between {formatIdr(guide.minimum)} and{" "}
          {formatIdr(guide.maximum)} per night for {bedrooms}-bedroom villas.
        </p>
        <p class="mt-1 text-xs leading-relaxed text-muted">
          Checked 29 July 2026. Prices vary by date, villa, stay length, availability,
          taxes and account-specific promotions. This is a guide, not a live quote.
        </p>
      </div>

      <form class="mt-7 space-y-5" data-rate-form>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">
              Arrival
            </span>
            <input
              type="date"
              name="checkIn"
              min={PRICING_START}
              max={PRICING_LAST_NIGHT}
              required
              class="w-full border border-hairline bg-sand px-3 py-3 text-sm text-ink focus:border-ocean focus:outline-none"
            />
          </label>
          <label class="block">
            <span class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">
              Departure
            </span>
            <input
              type="date"
              name="checkOut"
              min={PRICING_START}
              max={PRICING_CHECKOUT_MAX}
              required
              class="w-full border border-hairline bg-sand px-3 py-3 text-sm text-ink focus:border-ocean focus:outline-none"
            />
          </label>
        </div>

        <label class="block">
          <span class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">
            Guests
          </span>
          <select
            name="guests"
            class="w-full border border-hairline bg-sand px-3 py-3 text-sm text-ink focus:border-ocean focus:outline-none"
          >
            {Array.from({ length: maximumGuests }, (_, index) => index + 1).map(
              (guests) => (
                <option value={guests} selected={guests === maximumGuests}>
                  {guests} guest{guests === 1 ? "" : "s"}
                </option>
              ),
            )}
          </select>
        </label>
      </form>

      <p
        class="mt-5 hidden border-l-2 border-clay pl-3 text-sm text-ink"
        data-rate-message
        aria-live="polite"
      />

      <div class="mt-6">
        <a
          href={showGuestyCta ? guestyHref : airbnbUrl ?? genericWaHref ?? "/contact"}
          target={showGuestyCta || airbnbUrl || genericWaHref ? "_blank" : undefined}
          rel={showGuestyCta || airbnbUrl || genericWaHref ? "noopener noreferrer" : undefined}
          class="btn-primary w-full"
          data-rate-cta
          data-track="start_booking"
          data-villa={landmarkName}
        >
          {showGuestyCta
            ? "Check live availability"
            : airbnbUrl
              ? "Check live price on Airbnb"
              : genericWaHref
                ? "Confirm dates on WhatsApp"
                : "Send an enquiry"}
        </a>
        {airbnbUrl && genericWaHref && (
          <a
            href={genericWaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 block text-center text-sm text-ocean underline underline-offset-4"
            data-track="whatsapp_click"
            data-villa={landmarkName}
          >
            Ask a question on WhatsApp
          </a>
        )}
        <p class="mt-3 text-center text-xs leading-relaxed text-muted">
          The booking platform shows the live total, applicable fees, availability,
          cancellation terms and secure payment before you commit.
        </p>
      </div>

      {includes.length > 0 && (
        <ul class="mt-6 space-y-1.5 border-t border-hairline pt-5 text-sm text-ink">
          {includes.map((item) => (
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 shrink-0 bg-clay" aria-hidden="true" />
              {item}
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<script>
  import { airbnbBookingUrl } from "../lib/airbnb";
  import { PRICING_CHECKOUT_MAX } from "../lib/pricing";

  const DAY_MS = 86_400_000;

  const dateLabel = (isoDate: string) =>
    new Intl.DateTimeFormat("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(`${isoDate}T00:00:00Z`));

  document
    .querySelectorAll<HTMLElement>("[data-rate-handoff]")
    .forEach((section) => {
      const form = section.querySelector<HTMLFormElement>("[data-rate-form]");
      const checkIn = form?.elements.namedItem("checkIn") as HTMLInputElement | null;
      const checkOut = form?.elements.namedItem("checkOut") as HTMLInputElement | null;
      const guests = form?.elements.namedItem("guests") as HTMLSelectElement | null;
      const cta = section.querySelector<HTMLAnchorElement>("[data-rate-cta]");
      const message = section.querySelector<HTMLElement>("[data-rate-message]");
      const villa = section.dataset.villa ?? "Anjuna Bay villa";
      const airbnbUrl = section.dataset.airbnbUrl ?? "";
      const provider = section.dataset.bookingProvider ?? "whatsapp";
      const whatsappNumber = section.dataset.whatsappNumber ?? "";

      function refreshHandoff() {
        if (!checkIn?.value || !checkOut?.value || !guests?.value) {
          message?.classList.add("hidden");
          return;
        }

        const arrival = new Date(`${checkIn.value}T00:00:00Z`);
        const departure = new Date(`${checkOut.value}T00:00:00Z`);
        const nights = Math.round((departure.getTime() - arrival.getTime()) / DAY_MS);

        if (nights <= 0) {
          if (message) {
            message.textContent = "Departure must be after arrival.";
            message.classList.remove("hidden");
          }
          return;
        }

        message?.classList.add("hidden");
        if (cta && provider === "airbnb" && airbnbUrl) {
          cta.href = airbnbBookingUrl(airbnbUrl, {
            checkIn: checkIn.value,
            checkOut: checkOut.value,
            guests: Number(guests.value),
          });
          cta.textContent = "Check live price on Airbnb";
        } else if (cta && provider === "whatsapp" && whatsappNumber) {
          const text = [
            "Hello Anjuna Bay,",
            `I would like to check ${villa}.`,
            `Arrival: ${dateLabel(checkIn.value)}.`,
            `Departure: ${dateLabel(checkOut.value)}.`,
            `Guests: ${guests.value}.`,
            "Please confirm live availability, the final price, taxes, fees and booking terms.",
          ].join(" ");
          cta.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
          cta.textContent = "Confirm dates on WhatsApp";
        }
      }

      checkIn?.addEventListener("change", () => {
        if (!checkIn.value || !checkOut) return;
        const earliestDeparture = new Date(`${checkIn.value}T00:00:00Z`);
        earliestDeparture.setTime(earliestDeparture.getTime() + DAY_MS);
        const minimum = earliestDeparture.toISOString().slice(0, 10);
        checkOut.min = minimum;
        checkOut.max = PRICING_CHECKOUT_MAX;
        if (checkOut.value && checkOut.value < minimum) checkOut.value = "";
        refreshHandoff();
      });
      checkOut?.addEventListener("change", refreshHandoff);
      guests?.addEventListener("change", refreshHandoff);
    });
</script>
