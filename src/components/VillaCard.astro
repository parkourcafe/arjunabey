---
/**
 * VillaCard — collection-grid card. Order mirrors decision weights (docs/
 * BUILD.md §9.2/§9.3): image first, landmark name + walk-time + price, never
 * a unit code (CLAUDE.md rule 1).
 *
 * Editorial portrait crop with the name set over the image behind a soft
 * scrim — the composition luxury hotel collections use (Aman, Rosewood):
 * the photograph carries the page and the type sits inside it, rather than
 * a boxed card with a caption underneath.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatWalkTimes } from '../lib/walktimes';
import { leadAudience } from '../lib/audience';

export interface Props {
  villa: CollectionEntry<'villas'>;
}

const { villa } = Astro.props;
const d = villa.data;
const offPlan = d.status === 'off-plan';
const walk = formatWalkTimes(d.walkTimes)[0];
const suitedTo = leadAudience(d);
const priceLabel = offPlan
  ? 'Coming soon'
  : d.ratePublic
    ? `Seasonal rates from $${d.ratePublic} / night`
    : 'Enquire for rates';
---

<a
  href={`/villas/${villa.slug}`}
  data-bedrooms={d.bedrooms}
  data-view={d.view.toLowerCase()}
  class="group fade-in-up block"
>
  <div class="relative overflow-hidden bg-ink/5">
    <Image
      src={d.heroImage}
      alt={`${d.landmarkName} — ${d.bedrooms}-bedroom pool villa at Anjuna Bay`}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="aspect-[4/5] w-full object-cover transition-transform duration-[1200ms] ease-elegant group-hover:scale-[1.05]"
    />

    <!-- Scrim: keeps the name legible over any photograph, deepens slightly on hover -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/10 to-transparent opacity-90 transition-opacity duration-600 ease-elegant group-hover:opacity-100"
      aria-hidden="true"
    >
    </div>

    {
      offPlan && (
        <span class="absolute left-4 top-4 border border-paper/50 px-3 py-1 text-eyebrow uppercase text-paper backdrop-blur-sm">
          Coming soon
        </span>
      )
    }

    <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
      <h3 class="font-serif text-3xl font-light leading-tight text-paper md:text-4xl">{d.landmarkName}</h3>
      <p class="mt-2 text-sm text-paper/80 md:text-base">
        {d.bedrooms}-Bedroom Pool Villa{walk ? ` · ${walk.minutes} min to ${walk.label}` : ''}
      </p>
    </div>
  </div>

  {suitedTo && <p class="eyebrow pt-4 text-muted">{suitedTo}</p>}

  <div class="flex items-baseline justify-between gap-4 pt-2">
    <p class="text-sm text-ink">{priceLabel}</p>
    {
      d.rating && (
        <span class="shrink-0 text-sm text-muted">
          {d.rating.toFixed(2)}★{d.reviewCount ? ` (${d.reviewCount})` : ''}
        </span>
      )
    }
  </div>
</a>
