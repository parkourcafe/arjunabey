---
/**
 * FeatureSection — the alternating image/text block the whole homepage is
 * built from (the Aman New York rhythm: a large photograph paired with a
 * short, centred-weight statement and one quiet link, repeated down the page
 * with the image side alternating).
 *
 * Two layouts:
 *   'split' — image on one side, copy on the other, generous gutter.
 *   'full'  — full-bleed photograph with the copy laid over its lower third.
 *
 * Copy is deliberately short: an eyebrow, one serif line, one or two
 * sentences, one link. Anything longer belongs on the page it links to.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow?: string;
  heading: string;
  body?: string;
  cta?: { label: string; href: string };
  /** 'left' puts the photograph on the left (split layout only). */
  imageSide?: 'left' | 'right';
  variant?: 'split' | 'full';
  tone?: 'sand' | 'paper';
}

const {
  image,
  imageAlt,
  eyebrow,
  heading,
  body,
  cta,
  imageSide = 'left',
  variant = 'split',
  tone = 'sand',
} = Astro.props;
---

{
  variant === 'full' ? (
    <section class="relative flex h-[80vh] min-h-[520px] items-end overflow-hidden bg-ink">
      <Image
        src={image}
        alt={imageAlt}
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"
        aria-hidden="true"
      />
      <div class="container-content relative z-10 pb-16 text-paper md:pb-20">
        <div class="fade-in-up max-w-xl">
          {eyebrow && <p class="eyebrow mb-5 text-paper/75">{eyebrow}</p>}
          <h2 class="font-serif text-h1 font-light text-paper">{heading}</h2>
          {body && <p class="mt-5 text-base leading-relaxed text-paper/85">{body}</p>}
          {cta && (
            <a href={cta.href} class="link-quiet-on-dark mt-8 inline-block">
              {cta.label}
            </a>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class:list={['section', tone === 'paper' ? 'bg-paper' : 'bg-sand']}>
      <div class="container-content">
        <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-16 lg:gap-24">
          <div class:list={['overflow-hidden', imageSide === 'right' && 'md:order-2']}>
            <Image
              src={image}
              alt={imageAlt}
              widths={[600, 1000, 1400]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-[4/5] w-full object-cover md:aspect-[3/4]"
              loading="lazy"
            />
          </div>
          <div class="fade-in-up max-w-md">
            {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
            <h2 class="font-serif text-h1 font-light text-ink">{heading}</h2>
            {body && <p class="mt-5 text-base leading-relaxed text-muted">{body}</p>}
            {cta && (
              <a href={cta.href} class="link-quiet mt-8 inline-block">
                {cta.label}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}
