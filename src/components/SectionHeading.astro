---
/**
 * SectionHeading — consistent eyebrow + heading pattern used across pages.
 */
export interface Props {
  eyebrow?: string;
  heading: string;
  level?: 1 | 2;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  heading,
  level = 2,
  align = 'left',
  class: className = '',
} = Astro.props;
const HeadingTag = level === 1 ? 'h1' : 'h2';
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <HeadingTag class="font-serif text-h2 font-medium text-ink">{heading}</HeadingTag>
</div>
