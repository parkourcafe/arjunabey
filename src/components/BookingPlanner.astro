---
import type { CollectionEntry } from "astro:content";
import { airbnbListingUrl } from "../lib/airbnb";
import { whatsappLink, whatsappNumber } from "../lib/whatsapp";
import {
  PRICING_CHECKOUT_MAX,
  PRICING_LAST_NIGHT,
  PRICING_START,
  observedRateGuide,
} from "../lib/pricing";

export interface Props {
  villas: CollectionEntry<"villas">[];
}

const { villas } = Astro.props;
const waNumber = whatsappNumber();
const genericWaHref = whatsappLink();
---

<section
  class="border border-hairline bg-paper p-6 md:p-10"
  data-booking-planner
  data-whatsapp-number={waNumber ?? ""}
>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_0.85fr]">
    <div>
      <p class="eyebrow">Your stay</p>
      <h2 class="mt-2 font-serif text-3xl text-ink">
        Choose a villa and your dates
      </h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
        Select a villa and dates, then continue to its verified Airbnb listing
        for the live price, availability and secure checkout.
      </p>

      <form class="mt-8 space-y-5" data-booking-form>
        <label class="block">
          <span class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">
            Villa
          </span>
          <select
            name="villa"
            required
            class="w-full border border-hairline bg-sand px-4 py-3 text-sm text-ink focus:border-ocean focus:outline-none"
          >
            <option value="">Choose a villa</option>
            {
              villas.map((villa) => {
                const guide = observedRateGuide(villa.data.bedrooms);
                return (
                  <option
                    value={villa.data.landmarkName}
                    data-bedrooms={villa.data.bedrooms}
                    data-guests={villa.data.maximumGuests}
                    data-minimum={guide.minimum}
                    data-maximum={guide.maximum}
                    data-airbnb-url={airbnbListingUrl(villa.slug) ?? ""}
                  >
                    {villa.data.landmarkName} · {villa.data.bedrooms}-Bedroom Pool
                    Villa
                  </option>
                );
              })
            }
          </select>
        </label>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">
              Arrival
            </span>
            <input
              type="date"
              name="checkIn"
              min={PRICING_START}
              max={PRICING_LAST_NIGHT}
              required
              class="w-full border border-hairline bg-sand px-4 py-3 text-sm text-ink focus:border-ocean focus:outline-none"
            />
          </label>
          <label class="block">
            <span class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">
              Departure
            </span>
            <input
              type="date"
              name="checkOut"
              min={PRICING_START}
              max={PRICING_CHECKOUT_MAX}
              required
              class="w-full border border-hairline bg-sand px-4 py-3 text-sm text-ink focus:border-ocean focus:outline-none"
            />
          </label>
        </div>

        <label class="block">
          <span class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">
            Guests
          </span>
          <select
            name="guests"
            disabled
            class="w-full border border-hairline bg-sand px-4 py-3 text-sm text-ink disabled:opacity-60 focus:border-ocean focus:outline-none"
          >
            <option value="">Choose a villa first</option>
          </select>
        </label>
      </form>
    </div>

    <div class="flex min-h-[300px] flex-col justify-between border-l-0 border-hairline lg:border-l lg:pl-10">
      <div>
        <p class="eyebrow">Observed OTA guide</p>
        <div class="mt-8" data-planner-empty>
          <p class="font-serif text-2xl text-ink">Live rates, without guessing.</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Select a villa to see the observed category range. Your booking
            platform will show the exact total for the chosen dates.
          </p>
        </div>

        <p
          class="mt-8 hidden border-l-2 border-clay pl-3 text-sm text-ink"
          data-planner-error
          role="status"
          aria-live="polite"
        />

        <div class="mt-8 hidden" data-planner-result aria-live="polite">
          <p class="font-serif text-2xl text-ink" data-planner-villa />
          <p class="mt-1 text-sm text-muted" data-planner-dates />
          <div class="mt-6 border-l-2 border-clay pl-4">
            <p class="text-xs uppercase tracking-[0.12em] text-muted">
              Observed nightly range
            </p>
            <p class="mt-2 font-serif text-3xl text-ink" data-planner-range />
            <p class="mt-2 text-xs leading-relaxed text-muted">
              Based on public OTA calendars supplied on 29 July 2026. This is
              not a live quote and may vary by villa, availability, fees and promotions.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <a
          href="/villas"
          class="btn-primary w-full"
          data-planner-cta
          data-track="start_booking"
        >
          Choose a villa first
        </a>
        {
          genericWaHref && (
            <a
              href={genericWaHref}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 hidden text-center text-sm text-ocean underline underline-offset-4"
              data-planner-whatsapp
              data-track="whatsapp_click"
            >
              Ask a question on WhatsApp
            </a>
          )
        }
        <p class="mt-3 text-center text-xs leading-relaxed text-muted">
          Airbnb provides the live total, applicable fees, availability,
          cancellation terms and secure payment.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { airbnbBookingUrl } from "../lib/airbnb";
  import { PRICING_CHECKOUT_MAX } from "../lib/pricing";

  const DAY_MS = 86_400_000;
  const idr = (amount: number) =>
    new Intl.NumberFormat("en-ID", {
      style: "currency",
      currency: "IDR",
      currencyDisplay: "narrowSymbol",
      maximumFractionDigits: 0,
    }).format(amount);
  const dateLabel = (isoDate: string) =>
    new Intl.DateTimeFormat("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(`${isoDate}T00:00:00Z`));

  document
    .querySelectorAll<HTMLElement>("[data-booking-planner]")
    .forEach((planner) => {
      const form = planner.querySelector<HTMLFormElement>("[data-booking-form]");
      const villaSelect = form?.elements.namedItem("villa") as HTMLSelectElement | null;
      const checkIn = form?.elements.namedItem("checkIn") as HTMLInputElement | null;
      const checkOut = form?.elements.namedItem("checkOut") as HTMLInputElement | null;
      const guestSelect = form?.elements.namedItem("guests") as HTMLSelectElement | null;
      const result = planner.querySelector<HTMLElement>("[data-planner-result]");
      const empty = planner.querySelector<HTMLElement>("[data-planner-empty]");
      const error = planner.querySelector<HTMLElement>("[data-planner-error]");
      const cta = planner.querySelector<HTMLAnchorElement>("[data-planner-cta]");
      const whatsappCta = planner.querySelector<HTMLAnchorElement>("[data-planner-whatsapp]");
      const whatsappNumber = planner.dataset.whatsappNumber ?? "";

      const selectedVilla = () => villaSelect?.selectedOptions[0] ?? null;

      function updateGuests() {
        if (!guestSelect) return;
        const maximumGuests = Number(selectedVilla()?.dataset.guests ?? 0);
        guestSelect.replaceChildren();
        if (!maximumGuests) {
          guestSelect.append(new Option("Choose a villa first", ""));
          guestSelect.disabled = true;
          return;
        }
        for (let guests = 1; guests <= maximumGuests; guests += 1) {
          guestSelect.append(new Option(`${guests} guest${guests === 1 ? "" : "s"}`, String(guests)));
        }
        guestSelect.value = String(maximumGuests);
        guestSelect.disabled = false;
      }

      function resetCta(label: string) {
        if (cta) {
          cta.href = "/villas";
          cta.removeAttribute("target");
          cta.removeAttribute("rel");
          cta.textContent = label;
        }
        whatsappCta?.classList.add("hidden");
        whatsappCta?.classList.remove("block");
      }

      function refresh() {
        const option = selectedVilla();
        if (!option?.value) {
          result?.classList.add("hidden");
          error?.classList.add("hidden");
          empty?.classList.remove("hidden");
          resetCta("Choose a villa first");
          return;
        }

        empty?.classList.add("hidden");
        result?.classList.remove("hidden");
        error?.classList.add("hidden");

        const villaLabel = planner.querySelector<HTMLElement>("[data-planner-villa]");
        const datesLabel = planner.querySelector<HTMLElement>("[data-planner-dates]");
        const rangeLabel = planner.querySelector<HTMLElement>("[data-planner-range]");
        if (villaLabel) villaLabel.textContent = option.value;
        if (rangeLabel) {
          rangeLabel.textContent = `${idr(Number(option.dataset.minimum))}–${idr(Number(option.dataset.maximum))}`;
        }

        const hasDates = Boolean(checkIn?.value && checkOut?.value && guestSelect?.value);
        if (datesLabel) {
          datesLabel.textContent = hasDates
            ? `${dateLabel(checkIn!.value)} – ${dateLabel(checkOut!.value)}`
            : "Choose dates to continue to live availability";
        }

        if (!hasDates) {
          resetCta("Choose dates to check live price");
          return;
        }

        const arrival = new Date(`${checkIn!.value}T00:00:00Z`);
        const departure = new Date(`${checkOut!.value}T00:00:00Z`);
        if (departure.getTime() <= arrival.getTime()) {
          if (error) {
            error.textContent = "Departure must be after arrival.";
            error.classList.remove("hidden");
          }
          resetCta("Check your dates");
          return;
        }

        const airbnbUrl = option.dataset.airbnbUrl ?? "";
        const message = [
          "Hello Anjuna Bay,",
          `I would like to check ${option.value}.`,
          `Arrival: ${dateLabel(checkIn!.value)}.`,
          `Departure: ${dateLabel(checkOut!.value)}.`,
          `Guests: ${guestSelect!.value}.`,
          "Please confirm live availability, the final price, taxes, fees and booking terms.",
        ].join(" ");

        if (cta && airbnbUrl) {
          cta.href = airbnbBookingUrl(airbnbUrl, {
            checkIn: checkIn!.value,
            checkOut: checkOut!.value,
            guests: Number(guestSelect!.value),
          });
          cta.target = "_blank";
          cta.rel = "noopener noreferrer";
          cta.textContent = "Check live price on Airbnb";
        } else if (cta && whatsappNumber) {
          cta.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
          cta.target = "_blank";
          cta.rel = "noopener noreferrer";
          cta.textContent = "Confirm dates on WhatsApp";
        }

        if (whatsappCta && whatsappNumber) {
          whatsappCta.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
          whatsappCta.classList.remove("hidden");
          whatsappCta.classList.add("block");
        }
      }

      villaSelect?.addEventListener("change", () => {
        updateGuests();
        refresh();
      });
      checkIn?.addEventListener("change", () => {
        if (!checkIn.value || !checkOut) return;
        const earliestDeparture = new Date(`${checkIn.value}T00:00:00Z`);
        earliestDeparture.setTime(earliestDeparture.getTime() + DAY_MS);
        const minimum = earliestDeparture.toISOString().slice(0, 10);
        checkOut.min = minimum;
        checkOut.max = PRICING_CHECKOUT_MAX;
        if (checkOut.value && checkOut.value < minimum) checkOut.value = "";
        refresh();
      });
      checkOut?.addEventListener("change", refresh);
      guestSelect?.addEventListener("change", refresh);
    });
</script>
