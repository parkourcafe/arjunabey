---
/**
 * Header — two-tier navigation on the Aman model: a top bar carrying the
 * centred wordmark with utilities either side, and a section bar beneath it
 * listing the property's pages. Reserve + WhatsApp are always visible
 * (CLAUDE.md rule 3), on desktop and in the mobile drawer.
 *
 * `transparent` lets the homepage hero show through until the user scrolls,
 * at which point the bar condenses to a solid surface.
 */
import WhatsAppButton from './WhatsAppButton.astro';

export interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const NAV = [
  { label: 'Villas', href: '/villas' },
  { label: 'Experiences', href: '/experiences' },
  { label: 'The Place', href: '/the-place' },
  { label: 'Offers', href: '/offers' },
  { label: 'Journal', href: '/journal' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header
  id="site-header"
  data-transparent={transparent ? 'true' : 'false'}
  class:list={[
    'fixed inset-x-0 top-0 z-40 transition-colors duration-400 ease-elegant',
    transparent ? 'bg-transparent' : 'bg-sand/95 backdrop-blur',
  ]}
>
  <!-- Tier one: utilities left, wordmark centred, Reserve right -->
  <div class="container-content relative flex h-16 items-center justify-between md:h-20">
    <div class="flex min-w-0 items-center gap-4">
      <button
        type="button"
        id="menu-toggle"
        class="flex items-center gap-2.5 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-header-link
      >
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M0 1h20M0 7h20M0 13h20" />
        </svg>
        <span class="hidden text-eyebrow uppercase xs:inline">Menu</span>
      </button>
      <span class="hidden text-eyebrow uppercase lg:inline" data-header-link>Uluwatu, Bali</span>
    </div>

    <a
      href="/"
      class="whitespace-nowrap px-2 font-serif text-sm font-light uppercase tracking-[0.14em] no-underline sm:absolute sm:left-1/2 sm:-translate-x-1/2 sm:text-base sm:tracking-[0.18em] md:text-xl md:tracking-[0.22em]"
      data-header-mark
    >
      Anjuna&nbsp;Bay
    </a>

    <div class="flex items-center gap-3">
      <div class="hidden lg:block">
        <WhatsAppButton variant="icon" />
      </div>
      <a href="/book" class="btn-primary !px-5 !py-2.5 md:!px-7 md:!py-3" data-track="start_booking">
        Reserve
      </a>
    </div>
  </div>

  <!-- Tier two: the property's sections -->
  <div class="hidden border-t border-hairline/60 lg:block" data-header-rule>
    <div class="container-content flex h-11 items-center justify-center gap-9">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-eyebrow uppercase no-underline transition-colors duration-400 ease-elegant"
            data-header-link
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-hairline bg-sand px-6 pb-8 pt-4 lg:hidden">
    <nav aria-label="Mobile primary" class="flex flex-col">
      {
        NAV.map((item) => (
          <a href={item.href} class="border-b border-hairline py-3.5 font-serif text-lg text-ink no-underline">
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-6 flex flex-col gap-3">
      <a href="/book" class="btn-primary w-full" data-track="start_booking">Reserve</a>
      <WhatsAppButton variant="button" class="w-full" />
    </div>
  </div>
</header>

<style>
  /* Transparent-over-hero state: light text/icons until scrolled. */
  header[data-transparent='true']:not(.scrolled) [data-header-mark],
  header[data-transparent='true']:not(.scrolled) [data-header-link] {
    color: var(--color-paper);
  }
  /* The scrim has to carry both tiers of the bar against whatever the hero
     photograph puts behind them. Measured against the aerial frame — whose
     top third is a bright hazy sky — a 0.4 wash left the nav at 2.8:1, below
     the 4.5:1 WCAG AA needs for text this size. */
  header[data-transparent='true']:not(.scrolled) {
    background: linear-gradient(
      to bottom,
      rgba(20, 18, 15, 0.66) 0%,
      rgba(20, 18, 15, 0.52) 60%,
      rgba(20, 18, 15, 0.28) 88%,
      transparent 100%
    );
  }
  header[data-transparent='true']:not(.scrolled) [data-header-rule] {
    border-top-color: rgb(250 247 242 / 0.25);
  }
  /* Over the hero the Reserve CTA goes quiet; a solid block is the loudest
     thing on the screen otherwise. It returns to solid once condensed. */
  header[data-transparent='true']:not(.scrolled) .btn-primary {
    background: transparent;
    border: 1px solid rgb(250 247 242 / 0.6);
  }
  header[data-transparent='true']:not(.scrolled) .btn-primary:hover {
    background: rgb(250 247 242 / 0.12);
  }
  header.scrolled {
    background-color: rgb(243 238 231 / 0.96);
    border-bottom: 1px solid var(--color-hairline);
  }
  [data-header-link],
  [data-header-mark] {
    color: var(--color-ink);
  }
  [data-header-link]:hover {
    color: var(--color-ocean);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  function onScroll() {
    if (!header) return;
    header.classList.toggle('scrolled', window.scrollY > 24);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  menuToggle?.addEventListener('click', () => {
    const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!expanded));
    mobileMenu?.classList.toggle('hidden');
    menuToggle.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
  });
</script>
