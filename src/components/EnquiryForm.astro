---
/**
 * EnquiryForm — posts to /api/enquiry.ts.
 *
 * If no recipient is configured the form renders disabled rather than
 * collecting a name, an email and a stay request that nobody receives. The
 * success message promises the property team will be in touch; sending that
 * into an unset mailbox makes it a lie from the first enquiry — and the first
 * one may well be submitted during the owner demo (ТЗ §4).
 *
 * Spam protection is layered: a honeypot here, a submit-too-fast trap here,
 * and the rate limit server-side. No CAPTCHA — it costs conversion and looks
 * cheap on a property this size.
 */
export interface Props {
  defaultSegment?: string;
}

const { defaultSegment = '' } = Astro.props;

// Read at build time. The key is a server-only secret, so it is never inlined
// into the client bundle — only the resulting boolean is. Destination and
// sender have confirmed defaults in the endpoint, so the key alone decides
// whether enquiries can be delivered.
const enquiriesOpen = Boolean(import.meta.env.EMAIL_API_KEY);
---

<div class="space-y-6">
  {
    !enquiriesOpen && (
      <div class="border border-hairline bg-sand p-5">
        <p class="text-sm leading-relaxed text-ink">
          Booking enquiries open shortly. In the meantime the fastest route to us is a message
          or an email — we answer both the same day.
        </p>
      </div>
    )
  }

  <form
  id="enquiry-form"
  class:list={['space-y-5', !enquiriesOpen && 'pointer-events-none select-none opacity-50']}
  novalidate
  inert={!enquiriesOpen}
  aria-hidden={!enquiriesOpen}
>
  <div class="hidden">
    <label for="company">Company</label>
    <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-1.5 block text-sm text-ink">Name</label>
      <input
        type="text" id="name" name="name" required
        class="w-full border border-hairline bg-sand px-3 py-2.5 text-sm focus:border-ocean focus:outline-none"
      />
    </div>
    <div>
      <label for="email" class="mb-1.5 block text-sm text-ink">Email</label>
      <input
        type="email" id="email" name="email" required
        class="w-full border border-hairline bg-sand px-3 py-2.5 text-sm focus:border-ocean focus:outline-none"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
    <div>
      <label for="dates" class="mb-1.5 block text-sm text-ink">Dates</label>
      <input
        type="text" id="dates" name="dates" placeholder="e.g. 12–18 Sep"
        class="w-full border border-hairline bg-sand px-3 py-2.5 text-sm focus:border-ocean focus:outline-none"
      />
    </div>
    <div>
      <label for="guests" class="mb-1.5 block text-sm text-ink">Guests</label>
      <input
        type="number" id="guests" name="guests" min="1"
        class="w-full border border-hairline bg-sand px-3 py-2.5 text-sm focus:border-ocean focus:outline-none"
      />
    </div>
    <div>
      <label for="segment" class="mb-1.5 block text-sm text-ink">Occasion</label>
      <select
        id="segment" name="segment"
        class="w-full border border-hairline bg-sand px-3 py-2.5 text-sm focus:border-ocean focus:outline-none"
      >
        <option value="" selected={!defaultSegment}>Prefer not to say</option>
        <option value="honeymoon" selected={defaultSegment === 'honeymoon'}>Honeymoon</option>
        <option value="surf" selected={defaultSegment === 'surf'}>Surf trip</option>
        <option value="long-stay" selected={defaultSegment === 'long-stay'}>Long stay</option>
        <option value="investment" selected={defaultSegment === 'investment'}>Investment enquiry</option>
        <option value="other">Other</option>
      </select>
    </div>
  </div>

  <div>
    <label for="message" class="mb-1.5 block text-sm text-ink">Message</label>
    <textarea
      id="message" name="message" rows="4"
      class="w-full resize-none border border-hairline bg-sand px-3 py-2.5 text-sm focus:border-ocean focus:outline-none"
    ></textarea>
  </div>

  <!-- The form takes a name, an email and a stay request. That is personal
       data, so consent is asked for explicitly rather than implied by the act
       of submitting. Unticked by default — a pre-ticked box is not consent. -->
  <div class="flex items-start gap-3">
    <input
      type="checkbox" id="consent" name="consent" required
      class="mt-1 h-4 w-4 shrink-0 accent-ocean"
    />
    <label for="consent" class="text-sm leading-relaxed text-muted">
      I agree to be contacted about this enquiry. See our
      <a href="/privacy" class="underline underline-offset-4">Privacy Notice</a>.
    </label>
  </div>

  <!-- Time-to-submit trap: filled and sent inside three seconds is a script,
       not a guest. Recorded here, enforced server-side. -->
  <input type="hidden" name="renderedAt" data-rendered-at />

  <button type="submit" class="btn-primary" data-enquiry-submit>Send enquiry</button>
  <p class="text-sm" data-enquiry-status role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  const form = document.getElementById('enquiry-form');
  const status = document.querySelector('[data-enquiry-status]');
  const submitBtn = document.querySelector('[data-enquiry-submit]');

  // The page is prerendered, so ?type= has to be honoured here rather than at
  // build time. Links like the footer's property-enquiry one otherwise land on
  // a form that gives no sign it knew what the guest clicked.
  const requestedSegment = new URLSearchParams(location.search).get('type');
  const segment = form?.querySelector('#segment');
  if (
    requestedSegment &&
    segment instanceof HTMLSelectElement &&
    Array.from(segment.options).some((o) => o.value === requestedSegment)
  ) {
    segment.value = requestedSegment;
  }

  // Stamped when the form is rendered rather than at page load, so the server
  // can tell a considered enquiry from an instant scripted post.
  const renderedAt = form?.querySelector('[data-rendered-at]');
  if (renderedAt instanceof HTMLInputElement) renderedAt.value = String(Date.now());

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement) || !status || !(submitBtn instanceof HTMLButtonElement)) return;

    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value ?? '';
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      status.textContent = "That email doesn't look quite right — mind checking it?";
      status.className = 'text-sm text-red-700';
      return;
    }

    const consent = form.elements.namedItem('consent');
    if (consent instanceof HTMLInputElement && !consent.checked) {
      status.textContent = 'Please confirm we may contact you about this enquiry.';
      status.className = 'text-sm text-red-700';
      consent.focus();
      return;
    }

    submitBtn.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'text-sm text-muted';

    try {
      const res = await fetch('/api/enquiry', { method: 'POST', body: new FormData(form) });
      if (!res.ok) throw new Error('request failed');
      status.textContent = "You're in. We usually reply within minutes.";
      status.className = 'text-sm text-ocean';
      form.reset();
      window.dispatchEvent(new CustomEvent('anjuna:track', { detail: { event: 'enquiry_submit' } }));
    } catch {
      status.textContent = 'Something went wrong — message us on WhatsApp instead and we\'ll pick it up directly.';
      status.className = 'text-sm text-red-700';
      // Without this the only sign the form is broken is guests quietly not
      // arriving (ТЗ §21).
      window.dispatchEvent(
        new CustomEvent('anjuna:track', { detail: { event: 'availability_request_error' } }),
      );
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
