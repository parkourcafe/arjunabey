---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LocationMap from '../components/LocationMap.astro';
import Neighbourhood from '../components/Neighbourhood.astro';
import { canonicalFor, faqPage } from '../lib/seo';

const page = await getEntry('pages', 'the-place');
const { Content } = await page.render();
const d = page.data;

const jsonLd = faqPage([
  {
    question: 'Is Anjuna Bay walkable to the beach?',
    answer:
      "Yes — each villa page states its exact walk-time to Thomas Beach. Most of the estate is a five-to-ten-minute walk.",
  },
  {
    question: 'Is there construction noise nearby?',
    answer:
      "Parts of the estate are still being built, typically 8am–5pm. We disclose this honestly on every villa page and can point you to the quietest option for your dates.",
  },
]);
---

<BaseLayout
  title={d.seo?.title ?? 'The Place | Anjuna Bay'}
  description={d.seo?.description ?? 'Thomas Beach and the quiet side of the Bukit.'}
  canonicalUrl={canonicalFor('/the-place')}
  jsonLd={jsonLd}
  transparentHeader={true}
>
  {
    d.heroImage && (
      <Hero
        image={d.heroImage}
        imageAlt="The clifftop above Thomas Beach, Uluwatu"
        eyebrow="Where you are"
        headline={d.title}
        subhead="Thomas Beach sits below the estate — a short walk down, and the quiet side of the Bukit all around it."
        height="tall"
      />
    )
  }

  <div class="container-content section pt-16 md:pt-20">
    <div class="prose-anjuna max-w-prose">
      <Content />
    </div>
  </div>

  <Neighbourhood tone="sand" />

  <LocationMap
    heading="Getting here"
    walkTimes={[
      { label: 'Thomas Beach', minutes: 3 },
      { label: 'Padang Padang', minutes: 5 },
    ]}
  />
</BaseLayout>
