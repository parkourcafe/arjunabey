---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { canonicalFor } from '../lib/seo';
---

<BaseLayout
  title="Privacy Notice | Anjuna Bay"
  description="How Anjuna Bay collects, uses and protects your data."
  canonicalUrl={canonicalFor('/privacy')}
>
  <PageIntro
    eyebrow='Legal'
    heading='Privacy Notice'
    lede='What we collect when you visit or enquire, and how it is used.'
  />

  <div class="container-content section max-w-prose">
        <div class="prose-anjuna">
      <p>
        This notice explains what information this website processes and how
        your choices are respected.
      </p>
      <h2>What we collect</h2>
      <p>
        This website does not currently take payment or store booking details.
        If you continue to Airbnb or WhatsApp, the information you provide is
        handled by that service under its own privacy terms. Only after you
        accept optional cookies may we collect aggregated analytics about how
        this website is used.
      </p>
      <h2>Cookies and consent</h2>
      <p>
        We ask before loading non-essential analytics. Your choice is stored in
        this browser and can be changed at any time through “Cookies” in the
        footer.
      </p>
      <h2>How to reach us</h2>
      <p>For any privacy question, message us via the <a href="/contact">contact page</a>.</p>
    </div>
  </div>
</BaseLayout>
