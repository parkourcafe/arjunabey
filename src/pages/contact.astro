---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import pageHero from "../assets/placeholders/contact-hero.jpg";
import SectionHeading from "../components/SectionHeading.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { canonicalFor, faqPage } from "../lib/seo";

const faqs = [
  {
    question: "What is your cancellation policy?",
    answer:
      "Cancellation terms are confirmed with the final rate before payment, so you can review them before committing.",
  },
  {
    question: "Do you arrange an airport transfer?",
    answer:
      "Yes. Airport transfers can be arranged on request; the current price is confirmed before booking.",
  },
  {
    question: "Is there construction near the villas?",
    answer:
      "Parts of the estate are still being built, typically 8am–5pm. Every villa page discloses this honestly, and we'll point you to the quietest option for your dates.",
  },
  {
    question: "How do I pay?",
    answer:
      "After availability is confirmed, the reservations team sends the applicable booking and payment instructions.",
  },
];
---

<BaseLayout
  title="Contact | Anjuna Bay"
  description="Message us on WhatsApp or send an enquiry — we usually reply within minutes."
  canonicalUrl={canonicalFor("/contact")}
  jsonLd={faqPage(faqs)}
  transparentHeader={true}
>
  <Hero
    image={pageHero}
    imageAlt="A villa entrance courtyard in late afternoon light"
    eyebrow="Get in touch"
    headline="Enquire"
    subhead="Message us for a fast reply, or send the form below and we will come back to you."
    height="tall"
  />

  <div class="container-content pb-section pt-16 md:pt-20">
    <SectionHeading eyebrow="Get in touch" heading="Enquire" />
    <p class="mt-5 max-w-xl text-ink">
      For immediate self-service booking, choose a villa and continue to its
      verified live Airbnb checkout. For questions about your dates or property
      enquiries, message us on WhatsApp.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/book" class="btn-primary">Plan and book a stay</a>
      <WhatsAppButton variant="button" />
    </div>

    <div class="mt-14 grid grid-cols-1 gap-16 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="border border-hairline bg-paper p-6 md:p-8">
          <p class="eyebrow">What to include</p>
          <h2 class="mt-2 font-serif text-3xl text-ink">
            We can help you choose well
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
            Send your preferred dates, number of guests and what matters most —
            beach access, workspace, a longer stay or the quietest available
            position.
          </p>
          <div class="mt-6">
            <WhatsAppButton
              variant="button"
              label="Start a WhatsApp conversation"
            />
          </div>
        </div>
      </div>

      <div>
        <p class="eyebrow mb-4">Frequently asked</p>
        <dl class="space-y-6">
          {
            faqs.map((f) => (
              <div>
                <dt class="text-sm font-medium text-ink">{f.question}</dt>
                <dd class="mt-1.5 text-sm leading-relaxed text-muted">
                  {f.answer}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</BaseLayout>
