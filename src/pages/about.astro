---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EstateStory from '../components/EstateStory.astro';
import { canonicalFor, breadcrumbList } from '../lib/seo';

const page = await getEntry('pages', 'about');
const { Content } = await page.render();
const d = page.data;

const jsonLd = breadcrumbList([
  { name: 'Home', url: canonicalFor('/') },
  { name: 'About', url: canonicalFor('/about') },
]);
---

<BaseLayout
  title={d.seo?.title ?? 'About the Estate — Cliffside Pool Villas, Uluwatu | Anjuna Bay'}
  description={d.seo?.description ?? 'Who looks after the cliffside pool villas at Anjuna Bay above Thomas Beach, how the estate is being built, and what we tell guests before they book.'}
  canonicalUrl={canonicalFor('/about')}
  jsonLd={jsonLd}
  transparentHeader={true}
>
  {
    d.heroImage && (
      <Hero
        image={d.heroImage}
        imageAlt="The Anjuna Bay estate above Thomas Beach"
        eyebrow="About"
        headline={d.title}
        height="tall"
      />
    )
  }
  <div class="container-content section">
    <div class="prose-anjuna max-w-prose">
      <Content />
    </div>
  </div>
  <EstateStory tone="paper" />
</BaseLayout>
