---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import pageHero from '../../assets/placeholders/experiences-hero.jpg';
import ExperienceTile from '../../components/ExperienceTile.astro';
import Neighbourhood from '../../components/Neighbourhood.astro';
import { canonicalFor, breadcrumbList } from '../../lib/seo';

const experiences = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);

const jsonLd = breadcrumbList([
  { name: 'Home', url: canonicalFor('/') },
  { name: 'Experiences', url: canonicalFor('/experiences') },
]);
---

<BaseLayout
  title="Experiences — Surf, Wellness and Dining in Uluwatu | Anjuna Bay"
  description="Surf, wellness, dining and celebrations at Anjuna Bay — plus a practical guide to getting around Uluwatu."
  canonicalUrl={canonicalFor('/experiences')}
  jsonLd={jsonLd}
  transparentHeader={true}
>
  <Hero
    image={pageHero}
    imageAlt='A clifftop terrace above the ocean at sunset, Uluwatu'
    eyebrow='Do'
    headline='Experiences'
    subhead='Reef breaks minutes away, massage in your own courtyard, a private chef on request — and the quiet the Bukit is known for.'
    height='tall'
  />

  <div class="container-content pb-section pt-16 md:pt-20">
    <div class="mt-12 grid grid-cols-2 gap-8 md:grid-cols-4">
      {experiences.map((exp) => <ExperienceTile experience={exp} />)}
    </div>
  </div>
  <Neighbourhood tone="paper" />
</BaseLayout>
