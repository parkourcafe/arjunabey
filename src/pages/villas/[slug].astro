---
/**
 * Villa detail — the conversion template. Section order mirrors decision
 * weights (docs/BUILD.md §9.3 / §3): gallery → title → story → facts →
 * location → rate/booking → reviews → Good to know → sticky bar (mobile).
 * Both 'live' and 'off-plan' villas get a static path — an off-plan page
 * exists so the estate's pipeline is honest and visible (RateBlock/
 * StickyBookingBar switch to a "Coming soon / Register interest" state and
 * never render as bookable — CLAUDE.md rule 7).
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VillaGallery from "../../components/VillaGallery.astro";
import AmenityList from "../../components/AmenityList.astro";
import WalkTimeMap from "../../components/WalkTimeMap.astro";
import RateBlock from "../../components/RateBlock.astro";
import RatingBadge from "../../components/RatingBadge.astro";
import GoodToKnow from "../../components/GoodToKnow.astro";
import StickyBookingBar from "../../components/StickyBookingBar.astro";
import StayAssistant from "../../components/StayAssistant.astro";
import { airbnbListingUrl } from "../../lib/airbnb";
import { vacationRental, breadcrumbList, canonicalFor } from "../../lib/seo";

export async function getStaticPaths() {
  const villas = await getCollection("villas");
  return villas.map((villa) => ({
    params: { slug: villa.slug },
    props: { villa },
  }));
}

const { villa } = Astro.props;
const d = villa.data;
const { Content } = await villa.render();

const canonicalUrl = canonicalFor(`/villas/${villa.slug}`);
const title =
  d.seo?.title ??
  `${d.landmarkName} — ${d.bedrooms}-Bedroom Pool Villa | Anjuna Bay`;
const description =
  d.seo?.description ??
  `${d.landmarkName} — a ${d.bedrooms}-bedroom cliffside pool villa at Anjuna Bay, a short walk from Thomas Beach, Uluwatu.`;

const jsonLd = [
  vacationRental(
    {
      landmarkName: d.landmarkName,
      bedrooms: d.bedrooms,
      ratePublic: d.ratePublic,
      currency: d.currency,
      rating: d.rating ?? null,
      reviewCount: d.reviewCount ?? null,
      heroImageUrl: d.heroImage.src,
    },
    canonicalUrl,
  ),
  breadcrumbList([
    { name: "Home", url: canonicalFor("/") },
    { name: "Villas", url: canonicalFor("/villas") },
    { name: d.landmarkName, url: canonicalUrl },
  ]),
];

const walkEntries = Object.entries(d.walkTimes);
const primaryWalk =
  walkEntries.length > 0 ? Math.min(...walkEntries.map(([, m]) => m)) : null;
const offPlan = d.status === "off-plan";
const airbnbUrl = airbnbListingUrl(villa.slug);
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
  noindex={offPlan}
  transparentHeader={true}
>
  <!-- Full-bleed opener: the villa arrives as a photograph with its name in
       it, the way a hotel presents a suite — the gallery follows below. -->
  <section
    class="relative flex h-[78vh] min-h-[520px] items-end overflow-hidden bg-ink"
  >
    <Image
      src={d.heroImage}
      alt={`${d.landmarkName} — ${d.bedrooms}-bedroom pool villa at Anjuna Bay`}
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/15 to-ink/25"
      aria-hidden="true"
    >
    </div>

    <div
      class="container-content relative z-10 pb-14 pt-32 text-paper md:pb-20"
    >
      {
        offPlan && (
          <span class="mb-5 inline-block border border-paper/50 px-3 py-1 text-eyebrow uppercase text-paper">
            Coming soon
          </span>
        )
      }
      <p class="eyebrow mb-4 text-paper/75">
        Anjuna Bay{primaryWalk ? ` · ${primaryWalk} min to Thomas Beach` : ""}
      </p>
      <h1 class="max-w-3xl font-serif text-display font-medium text-paper">
        {d.landmarkName}
      </h1>
      <p class="mt-4 font-serif text-lg italic text-paper/85 md:text-xl">
        {d.bedrooms}-Bedroom Pool Villa · Sleeps {d.maximumGuests}
      </p>
    </div>
  </section>

  <article class="pb-24 pt-14 md:pt-20">
    <div class="container-content">
      <VillaGallery images={[d.heroImage, ...d.gallery]} alt={d.landmarkName} />

      <div class="mt-14 grid grid-cols-1 gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <div>
            <RatingBadge
              rating={d.rating ?? null}
              reviewCount={d.reviewCount ?? null}
            />
          </div>

          <div class="prose-anjuna mt-6 max-w-prose">
            <Content />
          </div>

          <div class="mt-10">
            <AmenityList
              amenities={d.amenities}
              bedrooms={d.bedrooms}
              bathrooms={d.bathrooms}
              sizeSqm={d.sizeSqm}
              view={d.view}
            />
          </div>

          <div class="mt-10">
            <WalkTimeMap walkTimes={d.walkTimes} />
          </div>

          <div class="mt-10">
            <GoodToKnow text={d.goodToKnow} />
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-28">
            <RateBlock
              landmarkName={d.landmarkName}
              bedrooms={d.bedrooms}
              maximumGuests={d.maximumGuests}
              pricingAdjustmentPercent={d.pricingAdjustmentPercent}
              guestyUnitId={d.guestyUnitId}
              airbnbUrl={airbnbUrl}
              ratePublic={d.ratePublic}
              freeCancelRate={d.freeCancelRate ?? null}
              currency={d.currency}
              includes={d.includes}
              offPlan={offPlan}
            />
          </div>
        </aside>
      </div>
    </div>
  </article>

  <StickyBookingBar
    landmarkName={d.landmarkName}
    guestyUnitId={d.guestyUnitId}
    ratePublic={d.ratePublic}
    currency={d.currency}
    offPlan={offPlan}
  />
  <StayAssistant />
</BaseLayout>
