---
/**
 * Reserve — Guesty booking engine embed. noindex (docs/BUILD.md §9.10).
 * Until the direct Guesty engine is connected, the planner calculates the
 * stay and hands the guest to the villa's verified Airbnb live checkout.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import bookHero from "../assets/placeholders/book-hero.jpg";
import BookingPlanner from "../components/BookingPlanner.astro";
import StayAssistant from "../components/StayAssistant.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { canonicalFor } from "../lib/seo";
import { getCollection } from "astro:content";

const guestyBaseUrl = import.meta.env.PUBLIC_GUESTY_BOOKING_URL;
const villas = (await getCollection("villas"))
  .filter((villa) => villa.data.status === "live")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Reserve a Cliffside Pool Villa at Thomas Beach | Anjuna Bay"
  description="Check dates and guests for a cliffside pool villa at Anjuna Bay, a short walk from Thomas Beach in Uluwatu, and we will confirm the final rate."
  canonicalUrl={canonicalFor("/book")}
  noindex={true}
  transparentHeader={true}
>
  <Hero
    image={bookHero}
    imageAlt="A villa bedroom at Anjuna Bay in golden-hour light"
    eyebrow="Reserve"
    headline="Check availability"
    subhead="Choose your villa and dates, and we will come back with the final rate and terms."
    height="tall"
  />

  <div class="container-content pb-section pt-14 md:pt-20">

    {
      guestyBaseUrl ? (
        <div class="mt-10 aspect-[3/4] w-full border border-hairline md:aspect-[16/9]">
          <iframe
            src={guestyBaseUrl}
            title="Anjuna Bay booking engine"
            class="h-full w-full"
            loading="lazy"
          />
        </div>
      ) : (
        <>
          <div class="mt-10">
            <BookingPlanner villas={villas} />
          </div>
          <div class="mt-20 border-t border-hairline pt-12">
            <div>
              <p class="eyebrow">Prefer a conversation</p>
              <h2 class="mt-2 font-serif text-3xl text-ink">
                Tell us what would make the stay right
              </h2>
              <p class="mt-4 max-w-md text-sm leading-relaxed text-muted">
                Share your dates, group and what matters most. We can help match
                you to the right villa, while the live Airbnb checkout remains
                available for immediate booking.
              </p>
              <div class="mt-6">
                <WhatsAppButton variant="button" />
              </div>
            </div>
          </div>
        </>
      )
    }
  </div>
  <StayAssistant />
</BaseLayout>
