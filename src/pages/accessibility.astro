---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import pageImage from '../assets/placeholders/legal-hero.jpg';
import { canonicalFor } from '../lib/seo';
---

<BaseLayout
  title="Accessibility | Anjuna Bay"
  description="Our accessibility commitment for this website."
  canonicalUrl={canonicalFor('/accessibility')}
>
  <PageIntro
    image={pageImage}
    imageAlt='A sunlit limestone wall and still water in a villa courtyard'
    eyebrow='Legal'
    heading='Accessibility'
    lede='How this site is built to be usable by everyone, and how to tell us when it is not.'
  />

  <div class="container-content section max-w-prose">
        <div class="prose-anjuna">
      <p>
        This site is designed around WCAG 2.2 AA: keyboard-navigable menus and
        galleries, visible focus states, sufficient colour contrast,
        descriptive alt text and support for reduced-motion preferences.
      </p>
      <p>
        If you encounter a barrier using this site, please tell us via the
        <a href="/contact">contact page</a> and we'll fix it.
      </p>
    </div>
  </div>
</BaseLayout>
