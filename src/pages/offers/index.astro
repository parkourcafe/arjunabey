---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import pageHero from '../../assets/placeholders/offers-hero.jpg';
import OfferCard from '../../components/OfferCard.astro';
import { canonicalFor, breadcrumbList } from '../../lib/seo';

const offers = (await getCollection('offers', (o) => o.data.active)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const jsonLd = breadcrumbList([
  { name: 'Home', url: canonicalFor('/') },
  { name: 'Offers', url: canonicalFor('/offers') },
]);
---

<BaseLayout
  title="Book Direct Offers — Cliffside Pool Villas | Anjuna Bay"
  description="Review the observed OTA rate guide and confirmed booking options near Thomas Beach."
  canonicalUrl={canonicalFor('/offers')}
  jsonLd={jsonLd}
  transparentHeader={true}
>
  <Hero
    image={pageHero}
    imageAlt='A private villa pool at golden hour'
    eyebrow='Offers'
    headline='A few things we keep for direct guests'
    subhead='Our best available rate, a complimentary airport transfer, and a longer-stay rate for those who settle in.'
    height='tall'
  />

  <div class="container-content pb-section pt-16 md:pt-20">
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {offers.map((offer) => <OfferCard offer={offer} />)}
    </div>
  </div>
</BaseLayout>
