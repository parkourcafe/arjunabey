# Anjuna Bay — environment variables.
# Copy to .env and fill in. Never commit .env.
# PUBLIC_* are inlined into the client bundle; everything else stays server-side.

# --- Publication status -------------------------------------------------
# `preview` (default when unset) — noindex on every page, X-Robots-Tag header
# on every response, no sitemap. `production` — indexable. Only set this to
# production once the owner has approved publishing the site.
PUBLIC_SITE_STATUS=preview

# Canonical origin. Leave blank and the site follows the Vercel deployment
# URL automatically — set it once a real domain is attached.
PUBLIC_SITE_URL=

# --- Guest contact ------------------------------------------------------
# Digits only, no +, spaces or brackets: 6281XXXXXXXXX
# REQUIRED: with this unset no WhatsApp link renders anywhere on the site.
PUBLIC_WHATSAPP_NUMBER=

# --- Enquiry form -------------------------------------------------------
# All three are required together. With any of them missing the form renders
# disabled rather than accepting enquiries that reach nobody.
EMAIL_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM=

# --- Booking ------------------------------------------------------------
# Guesty booking engine URL. Unset → the planner hands over to the villa's
# verified Airbnb listing instead.
PUBLIC_GUESTY_BOOKING_URL=

# --- Analytics (loaded only after cookie consent) -----------------------
PUBLIC_GA=
PUBLIC_META_PIXEL_ID=
